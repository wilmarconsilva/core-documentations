          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Sync_Flow_3</incoming>
      <outgoing>Sync_Flow_4</outgoing>
    </serviceTask>
    <exclusiveGateway id="Sync_ProductMerge" name="" gatewayDirection="Converging">
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
