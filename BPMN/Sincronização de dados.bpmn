    <serviceTask id="Sync_ProductOk" name="Mapear id, remover registro local e resolver pendência">
      <documentation>Guarda o par id local → id do servidor (usado para reapontar pedidos e orçamentos), remove o registro do IndexedDB e resolve a pendência, se existir.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
