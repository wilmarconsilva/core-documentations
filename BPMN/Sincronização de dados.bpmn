    <serviceTask id="Sync_ProductSend" name="Enviar produtos ao back-end">
      <documentation>O id local é zerado (toApiCreatePayload) e o registro é enviado como um novo produto, autenticado com o JWT.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
