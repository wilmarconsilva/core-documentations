    <serviceTask id="Sync_CustomerFail" name="Registrar pendência do cliente">
      <documentation>Toda falha vira pendência, inclusive a indisponibilidade do servidor: chave '&lt;tipo&gt;:&lt;id local&gt;', descrição (o nome do cliente) e mensagem de falha. O registro continua no IndexedDB e é reenviado na próxima sincronização.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="Horizontal" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
