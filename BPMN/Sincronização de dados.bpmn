      <incoming>Sync_Flow_9</incoming>
      <outgoing>Sync_Flow_11</outgoing>
    </serviceTask>
    <serviceTask id="Sync_ProductFail" name="Registrar pendência do produto">
      <documentation>Toda falha vira pendência, inclusive a indisponibilidade do servidor: chave '&lt;tipo&gt;:&lt;id local&gt;', descrição (a descrição do produto) e mensagem de falha. O registro continua no IndexedDB e é reenviado na próxima sincronização.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
