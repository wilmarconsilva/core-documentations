    <serviceTask id="Sync_CustomerSave" name="Validar regras e salvar cliente no PostgreSQL">
      <documentation>Nome, documento (dígito verificador do CPF), e-mail e ao menos um endereço com localidade. Salvo em transação nas tabelas customers e customers_addresses; regra violada retorna HTTP 400 com a mensagem.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
