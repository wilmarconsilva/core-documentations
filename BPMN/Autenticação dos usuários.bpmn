<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026110203766" targetNamespace="http://www.bizagi.com/definitions/_2026110203766" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_5777f8e0-baa1-44cf-b41a-91c4f95be133" name="Core - Autenticação do usuário" isExecutable="false">
    <documentation>Autenticação por JWT (30 minutos) com chave de renovação rotativa (7 dias) guardada em cookie protegido. O Usuário interage apenas com o Front-end, e o Front-end é o único que se comunica com o Back-end.</documentation>
    <laneSet id="LaneSet_Authentication">
      <lane id="Lane_Authentication_U" name="Usuário">
        <flowNodeRef>Authentication_Start</flowNodeRef>
        <flowNodeRef>Authentication_Warn</flowNodeRef>
        <flowNodeRef>Authentication_Credentials</flowNodeRef>
        <flowNodeRef>Authentication_UseApp</flowNodeRef>
        <flowNodeRef>Authentication_Operate</flowNodeRef>
        <flowNodeRef>Authentication_GwAgain</flowNodeRef>
        <childLaneSet id="Id_5c1f97c2-fa56-4dd0-8866-5650522c7d8b" />
      </lane>
      <lane id="Lane_Authentication_A" name="Front-end">
        <flowNodeRef>Authentication_CheckBackEnd</flowNodeRef>
        <flowNodeRef>Authentication_GwBackEnd</flowNodeRef>
        <flowNodeRef>Authentication_MergeRenew</flowNodeRef>
        <flowNodeRef>Authentication_Request</flowNodeRef>
        <flowNodeRef>Authentication_GwInUse1</flowNodeRef>
        <flowNodeRef>Authentication_Discard</flowNodeRef>
        <flowNodeRef>Authentication_GwInUse2</flowNodeRef>
        <flowNodeRef>Authentication_SendCredentials</flowNodeRef>
        <flowNodeRef>Authentication_ShowError</flowNodeRef>
        <flowNodeRef>Authentication_StoreJwt</flowNodeRef>
        <flowNodeRef>Authentication_GwPending</flowNodeRef>
        <flowNodeRef>Authentication_Retry</flowNodeRef>
        <flowNodeRef>Authentication_Sync</flowNodeRef>
        <flowNodeRef>Authentication_SendOperation</flowNodeRef>
        <flowNodeRef>Authentication_ShowResult</flowNodeRef>
        <flowNodeRef>Authentication_Restore</flowNodeRef>
        <flowNodeRef>Authentication_MergeEnd</flowNodeRef>
        <flowNodeRef>Authentication_End</flowNodeRef>
        <flowNodeRef>Authentication_Unavailable</flowNodeRef>
        <childLaneSet id="Id_f90899e8-72d7-4753-b6a4-5a5f77a91228" />
      </lane>
      <lane id="Lane_Authentication_S" name="Back-end">
        <flowNodeRef>Authentication_Find</flowNodeRef>
        <flowNodeRef>Authentication_GwFound</flowNodeRef>
        <flowNodeRef>Authentication_GwRevoked</flowNodeRef>
        <flowNodeRef>Authentication_RevokeAll</flowNodeRef>
        <flowNodeRef>Authentication_GwExpired</flowNodeRef>
        <flowNodeRef>Authentication_RevokeExpired</flowNodeRef>
        <flowNodeRef>Authentication_IssueJwt</flowNodeRef>
        <flowNodeRef>Authentication_Rotate</flowNodeRef>
        <flowNodeRef>Authentication_MergeRefused</flowNodeRef>
        <flowNodeRef>Authentication_Validate</flowNodeRef>
        <flowNodeRef>Authentication_GwValid</flowNodeRef>
        <flowNodeRef>Authentication_OpenSession</flowNodeRef>
        <flowNodeRef>Authentication_VerifyJwt</flowNodeRef>
        <flowNodeRef>Authentication_GwJwt</flowNodeRef>
        <flowNodeRef>Authentication_Process</flowNodeRef>
        <childLaneSet id="Id_d026aa60-3471-42b3-8e7c-a60ef924ecd6" />
      </lane>
    </laneSet>
    <startEvent id="Authentication_Start" name="Aplicativo aberto">
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
