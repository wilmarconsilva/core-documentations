    <callActivity id="Authentication_Sync" name="Sincronização de dados" calledElement="Id_9b3e6c2a-4f1d-4e8a-b7c5-2d6f8a1e0c47">
      <documentation>Subprocesso detalhado no diagrama 'Sincronização de dados.bpmn'. Disparada em dois casos: na abertura do aplicativo, quando a renovação da sessão dá certo e o modo é resolvido como online, e após um login bem-sucedido. Roda em segundo plano, sem bloquear o uso, e uma única vez enquanto o aplicativo estiver aberto. A renovação automática durante o uso segue para a operação pendente e não dispara a sincronização.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="Horizontal" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;asynchronousBehavior&quot;:{},&quot;subProcessType&quot;:&quot;None&quot;,&quot;inputMappingType&quot;:&quot;None&quot;,&quot;outputMappingType&quot;:&quot;None&quot;,&quot;exitMode&quot;:&quot;AllTokens&quot;}" />
          </bizagi:BizagiProperties>
