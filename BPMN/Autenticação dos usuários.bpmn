          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Authentication_Flow_1</outgoing>
    </startEvent>
    <serviceTask id="Authentication_CheckBackEnd" name="Verificar conexão com o back-end">
      <documentation>Se EXPO_PUBLIC_OPERATION_MODE forçar o modo Offline, o back-end não é consultado. O modo de operação é decidido uma única vez, na abertura.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
