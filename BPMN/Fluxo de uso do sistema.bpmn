      </extensionElements>
      <incoming>Usage_Flow_13</incoming>
      <outgoing>Usage_Flow_19</outgoing>
    </serviceTask>
    <serviceTask id="Usage_ProductSave" name="Validar regras e salvar produto no PostgreSQL">
      <documentation>Description obrigatória e MeasureUnit válida. Salvo em transação na tabela products. Não há regra de unicidade da descrição.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
