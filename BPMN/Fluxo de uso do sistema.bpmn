    <userTask id="Usage_CustomerTask" name="Cadastrar cliente">
      <documentation>Dados gerais: Nome *, Tipo de Pessoa * (Física ou Jurídica), CPF * (máscara 000.000.000-00) ou CNPJ * (alfanumérico, sem máscara), E-mail e Inscrição Estadual. Endereço: Localidade * (busca em modal), Logradouro, Bairro, Número, Complemento e CEP (máscara 00000-000).</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="Horizontal" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;notifyOnMobile&quot;:false,&quot;isSingleton&quot;:false,&quot;isConditional&quot;:false}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Usage_Flow_20</incoming>
      <incoming>Usage_Flow_30</incoming>
      <incoming>Usage_Flow_24</incoming>
      <outgoing>Usage_Flow_21</outgoing>
    </userTask>
    <serviceTask id="Usage_CustomerValidate" name="Validar campos obrigatórios e máscaras">
      <documentation>Nome e documento obrigatórios; CPF com 14 caracteres ou CNPJ com 18 (com pontuação); e-mail vazio ou em formato válido; localidade obrigatória no endereço.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
