    </exclusiveGateway>
    <serviceTask id="Usage_ProductSend" name="Enviar produto ao back-end">
      <documentation>POST /products (ou PUT /products/{id} na edição), autenticado com o token JWT.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
