    <serviceTask id="Usage_ProductLocal" name="Salvar produto no IndexedDB">
      <documentation>Gera um id local negativo, grava no store 'products' e exibe 'Registro salvo localmente. Será sincronizado quando houver conexão com a internet.'</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
