<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026110209970" targetNamespace="http://www.bizagi.com/definitions/_2026110209970" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_ff9c3502-9ea7-4cdc-9610-4ce6d981fff5" name="Core - Fluxo de uso do sistema" isExecutable="false">
    <documentation>Fluxo completo de uso do Core: abertura (subprocessos de autenticação e de sincronização de dados), cadastro de produto e cliente, orçamento (cálculo, assinatura, salvamento online ou offline), geração de PDF, pedido a partir do orçamento e relatórios. O Usuário e o Cliente interagem apenas com o Front-end, e o Front-end é o único que se comunica com o Back-end.</documentation>
    <laneSet id="LaneSet_Usage">
      <lane id="Lane_Usage_U" name="Usuário">
        <flowNodeRef>Usage_Start</flowNodeRef>
        <flowNodeRef>Usage_ProductTask</flowNodeRef>
        <flowNodeRef>Usage_CustomerTask</flowNodeRef>
        <flowNodeRef>Usage_BudgetProducts</flowNodeRef>
        <flowNodeRef>Usage_BudgetCustomer</flowNodeRef>
        <flowNodeRef>Usage_BudgetValues</flowNodeRef>
        <flowNodeRef>Usage_BudgetObs</flowNodeRef>
        <flowNodeRef>Usage_PdfRequest</flowNodeRef>
        <flowNodeRef>Usage_OrderRequest</flowNodeRef>
        <flowNodeRef>Usage_OrderFill</flowNodeRef>
        <flowNodeRef>Usage_OrderGwSign</flowNodeRef>
        <flowNodeRef>Usage_ReportGw</flowNodeRef>
        <flowNodeRef>Usage_ReportInform</flowNodeRef>
        <childLaneSet id="Id_8a50d7fc-a42e-4f49-94a5-121d0435d1e6" />
      </lane>
      <lane id="Lane_Usage_C" name="Cliente">
        <flowNodeRef>Usage_BudgetSign</flowNodeRef>
        <flowNodeRef>Usage_OrderSign</flowNodeRef>
        <childLaneSet id="Id_78c69916-4683-40e4-9af9-5c884d686430" />
      </lane>
      <lane id="Lane_Usage_F" name="Front-end">
        <flowNodeRef>Usage_Auth</flowNodeRef>
        <flowNodeRef>Usage_GwMode</flowNodeRef>
        <flowNodeRef>Usage_Sync</flowNodeRef>
        <flowNodeRef>Usage_Local</flowNodeRef>
        <flowNodeRef>Usage_Merge</flowNodeRef>
        <flowNodeRef>Usage_ProductValidate</flowNodeRef>
        <flowNodeRef>Usage_ProductGwValid</flowNodeRef>
        <flowNodeRef>Usage_ProductGwMode</flowNodeRef>
        <flowNodeRef>Usage_ProductSend</flowNodeRef>
        <flowNodeRef>Usage_ProductLocal</flowNodeRef>
        <flowNodeRef>Usage_ProductOk</flowNodeRef>
        <flowNodeRef>Usage_ProductMerge</flowNodeRef>
        <flowNodeRef>Usage_CustomerValidate</flowNodeRef>
        <flowNodeRef>Usage_CustomerGwValid</flowNodeRef>
        <flowNodeRef>Usage_CustomerGwMode</flowNodeRef>
        <flowNodeRef>Usage_CustomerSend</flowNodeRef>
        <flowNodeRef>Usage_CustomerLocal</flowNodeRef>
        <flowNodeRef>Usage_CustomerOk</flowNodeRef>
        <flowNodeRef>Usage_CustomerMerge</flowNodeRef>
        <flowNodeRef>Usage_BudgetCalc</flowNodeRef>
        <flowNodeRef>Usage_BudgetValidate</flowNodeRef>
        <flowNodeRef>Usage_BudgetGwValid</flowNodeRef>
        <flowNodeRef>Usage_BudgetGwMode</flowNodeRef>
        <flowNodeRef>Usage_BudgetSend</flowNodeRef>
        <flowNodeRef>Usage_BudgetLocal</flowNodeRef>
        <flowNodeRef>Usage_BudgetOk</flowNodeRef>
        <flowNodeRef>Usage_BudgetMerge</flowNodeRef>
        <flowNodeRef>Usage_PdfGenerate</flowNodeRef>
        <flowNodeRef>Usage_OrderGwMode</flowNodeRef>
        <flowNodeRef>Usage_OrderFetch</flowNodeRef>
        <flowNodeRef>Usage_OrderOpen</flowNodeRef>
        <flowNodeRef>Usage_OrderValidate</flowNodeRef>
        <flowNodeRef>Usage_OrderGwValid</flowNodeRef>
        <flowNodeRef>Usage_OrderSend</flowNodeRef>
        <flowNodeRef>Usage_OrderOk</flowNodeRef>
        <flowNodeRef>Usage_ReportRequest</flowNodeRef>
        <flowNodeRef>Usage_ReportShow</flowNodeRef>
        <flowNodeRef>Usage_FinalMerge</flowNodeRef>
        <flowNodeRef>Usage_End</flowNodeRef>
        <childLaneSet id="Id_7edec51b-8d3f-41fb-8e19-b715d3bddfbc" />
      </lane>
      <lane id="Lane_Usage_B" name="Back-end">
        <flowNodeRef>Usage_ProductSave</flowNodeRef>
        <flowNodeRef>Usage_ProductGwRules</flowNodeRef>
        <flowNodeRef>Usage_CustomerSave</flowNodeRef>
        <flowNodeRef>Usage_CustomerGwRules</flowNodeRef>
        <flowNodeRef>Usage_BudgetRecalc</flowNodeRef>
        <flowNodeRef>Usage_BudgetGwRules</flowNodeRef>
        <flowNodeRef>Usage_BudgetSave</flowNodeRef>
        <flowNodeRef>Usage_OrderLoad</flowNodeRef>
        <flowNodeRef>Usage_OrderRecalc</flowNodeRef>
        <flowNodeRef>Usage_OrderGwRules</flowNodeRef>
        <flowNodeRef>Usage_OrderSave</flowNodeRef>
