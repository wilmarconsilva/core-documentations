        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Pending_Flow_4</incoming>
      <incoming>Pending_Flow_8</incoming>
      <incoming>Pending_Flow_12</incoming>
      <outgoing>Pending_Flow_5</outgoing>
    </userTask>
