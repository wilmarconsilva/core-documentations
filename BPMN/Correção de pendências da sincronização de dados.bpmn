    <serviceTask id="Pending_PSend" name="Reenviar como POST com id 0">
      <documentation>Um registro local é sempre enviado como um novo registro (resubmitLocalRecord).</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
