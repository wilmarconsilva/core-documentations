<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026110200760" targetNamespace="http://www.bizagi.com/definitions/_2026110200760" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_bd6786a2-c7b5-40c5-8560-435329f60ec0" name="Core - Correção de pendências da sincronização de dados" isExecutable="false">
    <documentation>Correção, pelo Usuário, dos registros criados offline cujo envio falhou na sincronização (diagrama 'Sincronização de dados.bpmn'). Disponível somente no modo online. O Usuário interage apenas com o Front-end, e o Front-end é o único que se comunica com o Back-end.</documentation>
    <laneSet id="LaneSet_Pending">
      <lane id="Lane_Pending_U" name="Usuário">
        <flowNodeRef>Pending_PStart</flowNodeRef>
        <flowNodeRef>Pending_POpen</flowNodeRef>
        <flowNodeRef>Pending_PEdit</flowNodeRef>
        <flowNodeRef>Pending_PFix</flowNodeRef>
        <childLaneSet id="Id_226fd226-3739-4b1b-bc95-1b1bdce232bf" />
      </lane>
      <lane id="Lane_Pending_F" name="Front-end">
        <flowNodeRef>Pending_PLoad</flowNodeRef>
        <flowNodeRef>Pending_PValidate</flowNodeRef>
        <flowNodeRef>Pending_PGwValid</flowNodeRef>
        <flowNodeRef>Pending_PSend</flowNodeRef>
        <flowNodeRef>Pending_PResolve</flowNodeRef>
        <flowNodeRef>Pending_POk</flowNodeRef>
        <flowNodeRef>Pending_PEnd</flowNodeRef>
        <childLaneSet id="Id_7e69d53f-2425-41a4-bcaf-656d63d1cc5b" />
      </lane>
      <lane id="Lane_Pending_B" name="Back-end">
        <flowNodeRef>Pending_PSave</flowNodeRef>
        <flowNodeRef>Pending_PGwOk</flowNodeRef>
        <childLaneSet id="Id_436f2a56-ccad-4340-a638-a995544c1e45" />
      </lane>
    </laneSet>
    <startEvent id="Pending_PStart" name="Pendência a corrigir">
      <documentation>Pendência registrada pela sincronização (diagrama 'Sincronização de dados.bpmn') quando o envio de um registro criado offline falha: rejeição do back-end ou falha de rede.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="Horizontal" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Pending_Flow_1</outgoing>
    </startEvent>
    <userTask id="Pending_POpen" name="Abrir interface gráfica Pendências de Sincronização">
      <documentation>Menu disponível somente no modo online. Grade com Cadastro, Descrição e Falha, 10 registros por página.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="Horizontal" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;notifyOnMobile&quot;:false,&quot;isSingleton&quot;:false,&quot;isConditional&quot;:false}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Pending_Flow_1</incoming>
      <outgoing>Pending_Flow_2</outgoing>
    </userTask>
    <userTask id="Pending_PEdit" name="Editar a pendência">
      <documentation>Botão 'Editar' na linha da pendência.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
