          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Pending_Flow_2</incoming>
      <outgoing>Pending_Flow_3</outgoing>
    </userTask>
    <serviceTask id="Pending_PLoad" name="Abrir formulário com o registro local">
      <documentation>O registro de id negativo é lido do IndexedDB mesmo no modo online e exibido no formulário do cadastro correspondente.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="Horizontal" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Pending_Flow_3</incoming>
      <outgoing>Pending_Flow_4</outgoing>
    </serviceTask>
    <userTask id="Pending_PFix" name="Corrigir e salvar o registro">
      <documentation>Ajusta os dados conforme a mensagem de falha e salva.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
